# Pick a Codex CLI model available to your account.
CODEX_MODEL=gpt-5

# Supported values depend on the selected model and Codex CLI version.
CODEX_REASONING_EFFORT=high

# Optional, non-critical Buzzing discovery candidates. Set to 0 to disable
# only this supplemental pool; regular news collection is unchanged.
DAILY_BRIEF_BUZZING_ENABLED=1
