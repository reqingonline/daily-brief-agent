# Gmail account used to receive exact subscribe/unsubscribe commands.
GMAIL_OWNER=owner@example.com

# SMTP delivery. Use an app password or provider-specific credential.
EMAIL_ADDRESS=sender@example.com
EMAIL_PASSWORD=replace-with-an-app-password
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=465
SMTP_FROM="Daily Brief <sender@example.com>"

# Optional subject fallback and explicit env-file location.
DAILY_BRIEF_SUBJECT=Daily Brief
DAILY_BRIEF_ENV_FILE=/opt/daily-brief-agent/.env

# Set an absolute path when Codex is not on systemd's default PATH.
CODEX_BIN=codex
